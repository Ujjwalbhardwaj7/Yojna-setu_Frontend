# YojanaSetu Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.

# Backend API base URL (M2 local dev server)
VITE_API_BASE_URL=http://localhost:8000

# Real M2 data is the default production path. Set true only for isolated UI work.
# true  → uses local mock data; no backend required
# false → calls the real backend at VITE_API_BASE_URL
VITE_USE_MOCK_DATA=false

# Supabase browser-safe credentials only. Never add SUPABASE_JWT_SECRET here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
